{
  "name": "@fuju/trace-sdk",
  "version": "0.1.10",
  "description": "Fuju Trace instrumentation SDK (TypeScript) — emit trace events with deterministic, engine-matching event_id",
  "type": "module",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "observability",
    "llm",
    "agent",
    "tracing",
    "trace",
    "opentelemetry"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/vibeinging/fuju-trace",
    "directory": "fuju-trace-sdk/typescript"
  },
  "homepage": "https://github.com/vibeinging/fuju-trace",
  "bugs": {
    "url": "https://github.com/vibeinging/fuju-trace/issues"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --import tsx test/test_sdk.ts",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.6.0"
  }
}
